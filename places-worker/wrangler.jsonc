// The KiwiCamping place pages without a full listing (Cristian, 14 Nov 2026): the ~5,500 places, rendered by
// the site's own place template (`PLACES_R2=1 npm run places:worker` → worker-dist), uploaded to the R2 bucket
// kiwicamping-places (scripts/sync-places-r2.mjs, only changed pages) and served by this Worker on the free
// plan: R2 has no file limit. Everything else stays on GitHub Pages: the Worker passes any other request
// through unchanged (src/index.js).
// Since 15 Nov 2026 it also serves the live trip and collection links (the app's "Send link"): the API at
// /api/links/* stores them in the bucket kiwicamping-links, and /trip/<id> and /collection/<id> show them.
{
  "name": "kiwicamping-places",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "PLACES", "bucket_name": "kiwicamping-places" },
    // The links people publish from the app. Never synced or emptied by the build (pages.yml creates it).
    { "binding": "LINKS", "bucket_name": "kiwicamping-links" }
  ],
  // Per IP (CF-Connecting-IP), free: writes to the links API, and reads of the API, the link pages and the DOC
  // alerts. The namespace ids are this site's own (AussieCamps uses 1001 and 1002 in the same Cloudflare account).
  "ratelimits": [
    { "name": "LINK_WRITES", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LINK_READS", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
  ],
  // Runs on these paths of campingapp.nz (the domain's DNS records are proxied through Cloudflare).
  "routes": [
    { "pattern": "campingapp.nz/places/*", "zone_name": "campingapp.nz" },
    { "pattern": "campingapp.nz/api/links/*", "zone_name": "campingapp.nz" },
    { "pattern": "campingapp.nz/trip/*", "zone_name": "campingapp.nz" },
    { "pattern": "campingapp.nz/collection/*", "zone_name": "campingapp.nz" },
    // DOC closure alerts for the app, with the server's DOC key (src/alerts.js; secret DOC_API_KEY).
    { "pattern": "campingapp.nz/api/alerts/*", "zone_name": "campingapp.nz" }
  ]
}
