// The KiwiCamping place pages without a full listing (Cristian, 14 Nov 2026): the ~5,500 places, rendered by
// the site's own place template (`PLACES_R2=1 npm run places:worker` → worker-dist), uploaded to the R2 bucket
// kiwicamping-places (scripts/sync-places-r2.mjs, only changed pages) and served by this Worker on the free
// plan: R2 has no file limit. Everything else stays on GitHub Pages: the Worker passes any other request
// through unchanged (src/index.js).
{
  "name": "kiwicamping-places",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "r2_buckets": [{ "binding": "PLACES", "bucket_name": "kiwicamping-places" }],
  // Runs on campingapp.nz/places/* (the domain's DNS records are proxied through Cloudflare).
  "routes": [{ "pattern": "campingapp.nz/places/*", "zone_name": "campingapp.nz" }]
}
