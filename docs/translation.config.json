{
  "schemaVersion": 1,
  "project": "kiwicamping",
  "catalogs": [
    {
      "id": "kiwicamping-website",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": [
        "de",
        "es",
        "fr",
        "it",
        "nl",
        "pt",
        "ja",
        "ko",
        "zh-hans",
        "zh-hant",
        "da",
        "sv",
        "nb",
        "cs",
        "pl"
      ],
      "source": "../lib/translations/en.json",
      "targets": [
        {
          "locale": "de",
          "path": "../lib/translations/de.json"
        },
        {
          "locale": "es",
          "path": "../lib/translations/es.json"
        },
        {
          "locale": "fr",
          "path": "../lib/translations/fr.json"
        },
        {
          "locale": "it",
          "path": "../lib/translations/it.json"
        },
        {
          "locale": "nl",
          "path": "../lib/translations/nl.json"
        },
        {
          "locale": "pt",
          "path": "../lib/translations/pt.json"
        },
        {
          "locale": "ja",
          "path": "../lib/translations/ja.json"
        },
        {
          "locale": "ko",
          "path": "../lib/translations/ko.json"
        },
        {
          "locale": "zh-hans",
          "path": "../lib/translations/zh-hans.json"
        },
        {
          "locale": "zh-hant",
          "path": "../lib/translations/zh-hant.json"
        },
        {
          "locale": "da",
          "path": "../lib/translations/da.json"
        },
        {
          "locale": "sv",
          "path": "../lib/translations/sv.json"
        },
        {
          "locale": "nb",
          "path": "../lib/translations/nb.json"
        },
        {
          "locale": "cs",
          "path": "../lib/translations/cs.json"
        },
        {
          "locale": "pl",
          "path": "../lib/translations/pl.json"
        }
      ],
      "protectedTerms": ["KiwiCamping", "Aotearoa", "Aoraki", "DOC", "Waka Kotahi", "NZD", "North Island", "South Island", "Stewart Island"],
      "varieties": { "pt": "pt-PT" },
      "register": { "de": "informal", "es": "informal", "fr": "formal", "it": "informal", "nl": "informal", "pt": "informal" }
    },
    {
      "id": "kiwicamping-website-zh-Hant",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": ["zh-Hant"],
      "source": "../lib/translations/en.json",
      "targets": [
        { "locale": "zh-Hant", "path": "../lib/translations/zh-hant.json" }
      ],
      "protectedTerms": ["KiwiCamping", "NZD", "DOC", "Aotearoa", "Aoraki", "Waka Kotahi"],
      "untranslatedKeys": ["ui.review*", "ui.reviewsEyebrow", "ui.reviewsTitle"],
      "glossary": {
        "North Island": { "zh-Hant": "北島" },
        "South Island": { "zh-Hant": "南島" },
        "Stewart Island": { "zh-Hant": "史都華島" }
      }
    }
  ]
}
