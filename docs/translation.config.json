{
  "schemaVersion": 1,
  "project": "kiwicamping",
  "catalogs": [
    {
      "id": "kiwicamping-website",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": [
        "de",
        "es",
        "fr",
        "it",
        "nl",
        "pt",
        "ja",
        "zh-hans",
        "zh-hant",
        "da",
        "sv",
        "nb",
        "cs",
        "pl"
      ],
      "source": "../lib/translations/en.json",
      "targets": [
        {
          "locale": "de",
          "path": "../lib/translations/de.json"
        },
        {
          "locale": "es",
          "path": "../lib/translations/es.json"
        },
        {
          "locale": "fr",
          "path": "../lib/translations/fr.json"
        },
        {
          "locale": "it",
          "path": "../lib/translations/it.json"
        },
        {
          "locale": "nl",
          "path": "../lib/translations/nl.json"
        },
        {
          "locale": "pt",
          "path": "../lib/translations/pt.json"
        },
        {
          "locale": "ja",
          "path": "../lib/translations/ja.json"
        },
        {
          "locale": "zh-hans",
          "path": "../lib/translations/zh-hans.json"
        },
        {
          "locale": "zh-hant",
          "path": "../lib/translations/zh-hant.json"
        },
        {
          "locale": "da",
          "path": "../lib/translations/da.json"
        },
        {
          "locale": "sv",
          "path": "../lib/translations/sv.json"
        },
        {
          "locale": "nb",
          "path": "../lib/translations/nb.json"
        },
        {
          "locale": "cs",
          "path": "../lib/translations/cs.json"
        },
        {
          "locale": "pl",
          "path": "../lib/translations/pl.json"
        }
      ],
      "protectedTerms": [
        "KiwiCamping",
        "Aotearoa",
        "Aoraki",
        "DOC",
        "Waka Kotahi",
        "NZD",
        "North Island",
        "South Island",
        "Stewart Island",
        "Te Waipounamu",
        "Rakiura"
      ],
      "varieties": {
        "pt": "pt-PT",
        "zh-hans": "zh-Hans",
        "zh-hant": "zh-Hant"
      },
      "register": {
        "de": "informal",
        "es": "informal",
        "fr": "formal",
        "it": "informal",
        "nl": "informal",
        "pt": "informal"
      }
    },
    {
      "id": "kiwicamping-website-ko",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": [
        "ko"
      ],
      "source": "../lib/translations/en.json",
      "targets": [
        {
          "locale": "ko",
          "path": "../lib/translations/ko.json"
        }
      ],
      "protectedTerms": [
        "KiwiCamping",
        "NZD",
        "DOC",
        "Aotearoa",
        "Aoraki",
        "Waka Kotahi"
      ],
      "untranslatedKeys": [
        "ui.review*",
        "ui.reviewsEyebrow",
        "ui.reviewsTitle"
      ],
      "glossary": {
        "New Zealand": {
          "ko": "뉴질랜드"
        },
        "holiday park": {
          "ko": "홀리데이 파크"
        },
        "freedom camping": {
          "ko": "프리덤 캠핑"
        },
        "self-contained": {
          "ko": "셀프 컨테인드"
        },
        "dump station": {
          "ko": "덤프 스테이션"
        },
        "Great Walk": {
          "ko": "그레이트 워크"
        },
        "North Island": {
          "ko": "북섬"
        },
        "South Island": {
          "ko": "남섬"
        },
        "working holiday": {
          "ko": "워킹홀리데이"
        }
      },
      "styleGuide": {
        "ko": "Follow docs/translation-style/ko.md: 해요체 throughout, native Korean travel-writer voice, standard 띄어쓰기, Hangul exonyms (북섬, 남섬, 퀸스타운) with Māori originals and macrons in parentheses on first mention, never bare 덤프, never 오프라인 지도."
      }
    }
  ]
}
