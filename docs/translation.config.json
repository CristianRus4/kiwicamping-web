{
  "schemaVersion": 1,
  "project": "kiwicamping",
  "catalogs": [
    {
      "id": "kiwicamping-website",
      "adapter": "web-json",
      "sourceLocale": "en",
      "locales": [
        "de",
        "es",
        "fr",
        "it",
        "nl",
        "pt",
        "ja",
        "ko",
        "zh-hans",
        "zh-hant"
      ],
      "source": "../lib/translations/en.json",
      "targets": [
        {
          "locale": "de",
          "path": "../lib/translations/de.json"
        },
        {
          "locale": "es",
          "path": "../lib/translations/es.json"
        },
        {
          "locale": "fr",
          "path": "../lib/translations/fr.json"
        },
        {
          "locale": "it",
          "path": "../lib/translations/it.json"
        },
        {
          "locale": "nl",
          "path": "../lib/translations/nl.json"
        },
        {
          "locale": "pt",
          "path": "../lib/translations/pt.json"
        },
        {
          "locale": "ja",
          "path": "../lib/translations/ja.json"
        },
        {
          "locale": "ko",
          "path": "../lib/translations/ko.json"
        },
        {
          "locale": "zh-hans",
          "path": "../lib/translations/zh-hans.json"
        },
        {
          "locale": "zh-hant",
          "path": "../lib/translations/zh-hant.json"
        }
      ],
      "protectedTerms": [
        "KiwiCamping",
        "Aotearoa",
        "Aoraki",
        "DOC",
        "Waka Kotahi",
        "NZD",
        "North Island",
        "South Island",
        "Stewart Island",
        "Te Waipounamu",
        "Rakiura"
      ],
      "varieties": {
        "pt": "pt-PT",
        "zh-hans": "zh-Hans",
        "zh-hant": "zh-Hant"
      },
      "register": {
        "de": "informal",
        "es": "informal",
        "fr": "formal",
        "it": "informal",
        "nl": "informal",
        "pt": "informal"
      }
    }
  ]
}
