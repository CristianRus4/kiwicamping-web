      "protectedTerms": [
        "KiwiCamping",
        "Aotearoa",
        "Aoraki",
        "DOC",
        "Waka Kotahi",
        "NZD",
        "North Island",
        "South Island",
        "Stewart Island",
        "Te Waipounamu",
        "Rakiura"
